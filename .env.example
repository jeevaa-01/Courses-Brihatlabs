# AgentLab uses platform-provided ChatGPT identity headers and a Sites-managed D1 binding.
# Configure these only in the hosting environment, never in source control.

# Required to create paid career-program orders and complete verified enrollment.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional GST rate in basis points (for example 1800 = 18%).
GST_RATE_BPS=0
