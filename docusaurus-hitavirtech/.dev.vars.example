# Local secrets for `wrangler pages dev` — copy to .dev.vars (git-ignored).
# In production these are set as Cloudflare Pages project environment variables,
# NOT committed anywhere.

# Google OAuth 2.0 credentials (APIs & Services → Credentials → OAuth client ID,
# type "Web application"). Authorized redirect URI must be:
#   https://learn.hitavirtech.com/auth/callback
# (and http://localhost:8788/auth/callback for local wrangler dev)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Random high-entropy string used to HMAC-sign session cookies.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
